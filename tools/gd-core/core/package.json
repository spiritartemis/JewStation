{
  "name": "gd-core",
  "version": "0.70.5",
  "description": "gd-core — 会话级核心工作流（板 / 三层账 / 认领 / 并发隔离）；零宿主依赖，可缺席席位与工作站",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./README.md",
    "./bin/gd": "./bin/gd",
    "./entry": "./entry.mjs"
  },
  "bin": {
    "gd-core": "./bin/gd"
  },
  "gd": {
    "layer": "core",
    "contractVersion": 2,
    "design": "../docs/gd-core-session-workflow-design.md",
    "sourceRoot": "..",
    "selfContained": true,
    "selfContainedScope": [
      "core",
      "work",
      "milestone",
      "req",
      "task",
      "handoff",
      "check",
      "ver",
      "skill"
    ],
    "closure": "./closure.json",
    "closureGuard": "scripts/core-closure-check.mjs"
  }
}
