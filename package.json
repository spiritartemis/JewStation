{
  "name": "jewstation",
  "version": "0.3.14-m1b",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:preview": "node scripts/build-images.mjs && NEXT_DIST_DIR=.next-preview next build && git checkout -- next-env.d.ts tsconfig.json",
    "start": "next start",
    "start:preview": "NEXT_DIST_DIR=.next-preview next start -p 3100 -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate:products": "node scripts/validate-products.mjs --sample",
    "prebuild": "node scripts/build-images.mjs"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
